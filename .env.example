# Production: Supabase PostgreSQL connection (URL-encode credentials). TLS verified.
DATABASE_MODE=postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local development only: DATABASE_MODE=local and AUTH_MODE=local.
# .data/local-db belongs to a single process. Run worker via local inline mode below.
AUTH_MODE=supabase
LOCAL_ADMIN_EMAIL=admin@techview.local
# Generate: npm exec tsx scripts/local-setup.ts (never use local auth in production)
LOCAL_PASSWORD_HASH=
SESSION_SECRET=
# Local only. Starts the same worker inside the web process; production uses npm run worker.
LOCAL_INLINE_WORKER=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=techview
EVOLUTION_WEBHOOK_SECRET=
# Public HTTPS origin of this application; used to register provider webhook.
APP_URL=http://localhost:3000
# Default true. Real sending also requires REAL_SEND_ENABLED=true on the server.
SIMULATION_MODE=true
REAL_SEND_ENABLED=false
# Optional official CA certificate for verified PostgreSQL TLS.
DATABASE_CA_CERT=
# Optional isolated PGlite directory for local tests only.
LOCAL_DATABASE_PATH=.data/local-db
